# Discord
DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=  # optional: set during dev for instant slash-command sync to one server
DISCORD_COMMAND_CHANNEL_ID=  # required: the channel the bot will post messages in

LOG_LEVEL=WARNING      # Set logger level  DEBUG, INFO, WARNING, ERROR

# Campaigns. Each campaign is a folder DATA_DIR/campaigns/<name>/ holding the
# group's campaign.txt and campaign.toml (both optional) plus transcripts/ and
# notes/, which the bot creates.
DATA_DIR=/app/data             # blank = /app/data, the same path in the Docker image and the dev container
DEFAULT_CAMPAIGN=default       # campaign used when a session doesn't name one: lowercase letters, digits, - and _

# Whisper (local speech-to-text, faster-whisper)
WHISPER_MODEL_SIZE=large-v3         # tiny|base|small|medium|large-v3 -- bigger = slower + more VRAM
WHISPER_DEVICE=cuda              # cuda|cpu -- use cpu for local dev/testing without a GPU
WHISPER_COMPUTE_TYPE=float16     # float16|int8_float16 for cuda, int8 for cpu
WHISPER_SILENCE_DEBOUNCE_S=0.6   # seconds of silence from a speaker before their buffered audio is transcribed

WHISPER_LANGUAGE=              #  examples: en, de ..
WHISPER_INITIAL_PROMPT=  # optional biases transcription style/vocab Example: This is a conversation about dungeons and dragons and fantasy

# Session notes (optional). With NOTES_ENABLED=false the bot only transcribes and
# none of the settings below are needed. There is no system prompt setting: the
# prompt ships with the bot.
NOTES_ENABLED=false            # true|false -- write session notes with GPT-6 Luna after /stop
OPENAI_API_KEY=                # required when NOTES_ENABLED=true
OPENAI_MODEL_ID=               # optional
NOTES_MAX_OUTPUT_TOKENS=16000  # most tokens the model may write per request, reasoning included
NOTES_TIMEOUT_S=900            # seconds before a model request is given up

# Google Docs upload (optional). Leave blank to keep notes local only. The key is
# shared by all campaigns; each campaign names its doc in its campaign.toml:
#   google_doc_id = "<ID from docs.google.com/document/d/<ID>/edit>"
GOOGLE_SERVICE_ACCOUNT_FILE=   # e.g. /app/secrets/google-service-account.json -- the service account's JSON key, never commit it
