# Discord
DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=  # optional: set during dev for instant slash-command sync to one server
DISCORD_COMMAND_CHANNEL_ID=  # required: the channel the bot will post messages in

LOG_LEVEL=WARNING      # Set logger level  DEBUG, INFO, WARNING, ERROR
TRANSCRIPTS_DIR=transcripts      # directory transcripts are written to, one .txt file per /transcribe session

# Whisper (local speech-to-text, faster-whisper)
WHISPER_MODEL_SIZE=large-v3         # tiny|base|small|medium|large-v3 -- bigger = slower + more VRAM
WHISPER_DEVICE=cuda              # cuda|cpu -- use cpu for local dev/testing without a GPU
WHISPER_COMPUTE_TYPE=float16     # float16|int8_float16 for cuda, int8 for cpu
WHISPER_SILENCE_DEBOUNCE_S=0.6   # seconds of silence from a speaker before their buffered audio is transcribed

WHISPER_LANGUAGE=              # optional blank = auto-detect, examples: en, de ..
WHISPER_INITIAL_PROMPT=  # optional biases transcription style/vocab Example: This is a conversation about dungeons and dragons and fantasy
